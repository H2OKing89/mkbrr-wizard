{
  "$defs": {
    "BatchJob": {
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "properties": {
              "piece_length": {
                "type": "integer"
              },
              "target_piece_count": {
                "type": "integer"
              }
            },
            "required": [
              "piece_length",
              "target_piece_count"
            ]
          }
        }
      ],
      "description": "One independently validated ``mkbrr create`` operation.",
      "properties": {
        "path": {
          "description": "Absolute host or container source path",
          "format": "absolute-path",
          "minLength": 1,
          "not": {
            "pattern": "(?:\\u0000|\\s$)"
          },
          "pattern": "^/(?:[\\s\\S]*\\S)?$",
          "title": "Path",
          "type": "string"
        },
        "output": {
          "description": "Absolute .torrent output path",
          "format": "absolute-path",
          "minLength": 1,
          "not": {
            "pattern": "(?:\\u0000|\\s$)"
          },
          "pattern": "^/[\\s\\S]*\\.torrent$",
          "title": "Output",
          "type": "string"
        },
        "trackers": {
          "description": "Tracker announce URIs",
          "items": {
            "format": "uri",
            "minLength": 1,
            "not": {
              "pattern": "[\\s\\u0000-\\u001F]"
            },
            "pattern": "^(?:[Hh][Tt][Tt][Pp][Ss]?|[Uu][Dd][Pp]|[Ww][Ss][Ss]?)://[^\\s\\u0000-\\u001F/?#]+[^\\s\\u0000-\\u001F]*$",
            "type": "string"
          },
          "title": "Trackers",
          "type": "array"
        },
        "webseeds": {
          "description": "HTTP(S) webseed URIs",
          "items": {
            "format": "uri",
            "minLength": 1,
            "not": {
              "pattern": "[\\s\\u0000-\\u001F]"
            },
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F/?#]+[^\\s\\u0000-\\u001F]*$",
            "type": "string"
          },
          "title": "Webseeds",
          "type": "array"
        },
        "private": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the preset privacy flag",
          "title": "Private"
        },
        "no_date": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit the creation date",
          "title": "No Date"
        },
        "entropy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Add entropy to the info dictionary",
          "title": "Entropy"
        },
        "skip_prefix": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Do not prefix output with tracker",
          "title": "Skip Prefix"
        },
        "fail_on_season_warning": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fail when a season pack appears incomplete",
          "title": "Fail On Season Warning"
        },
        "no_creator": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit the creator string",
          "title": "No Creator"
        },
        "piece_length": {
          "anyOf": [
            {
              "maximum": 27,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit piece-length exponent",
          "title": "Piece Length"
        },
        "max_piece_length": {
          "anyOf": [
            {
              "maximum": 27,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum automatically selected piece-length exponent",
          "title": "Max Piece Length"
        },
        "target_piece_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 18446744073709551615,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Approximate target number of pieces",
          "title": "Target Piece Count"
        },
        "name": {
          "default": "",
          "description": "Override the torrent metadata name",
          "not": {
            "pattern": "(?:\\u0000|\\s$)"
          },
          "pattern": "^(?:$|\\S(?:[\\s\\S]*\\S)?)$",
          "title": "Name",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "not": {
                "pattern": "(?:\\u0000|\\s$)"
              },
              "pattern": "^(?:$|\\S(?:[\\s\\S]*\\S)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Torrent comment override; empty explicitly clears a preset value",
          "title": "Comment"
        },
        "source": {
          "anyOf": [
            {
              "not": {
                "pattern": "(?:\\u0000|\\s$)"
              },
              "pattern": "^(?:$|\\S(?:[\\s\\S]*\\S)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Torrent source override; empty also disables tracker inference",
          "title": "Source"
        },
        "exclude_patterns": {
          "description": "Glob patterns to exclude",
          "items": {
            "minLength": 1,
            "not": {
              "pattern": "(?:\\u0000|\\s$)"
            },
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "title": "Exclude Patterns",
          "type": "array"
        },
        "include_patterns": {
          "description": "Glob patterns to include",
          "items": {
            "minLength": 1,
            "not": {
              "pattern": "(?:\\u0000|\\s$)"
            },
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "title": "Include Patterns",
          "type": "array"
        }
      },
      "required": [
        "path",
        "output"
      ],
      "title": "BatchJob",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned collection of batch jobs with manifest-wide invariants.",
  "properties": {
    "version": {
      "const": 1,
      "description": "Batch manifest format version",
      "title": "Version",
      "type": "integer"
    },
    "jobs": {
      "description": "Torrent creation jobs",
      "items": {
        "$ref": "#/$defs/BatchJob"
      },
      "minItems": 1,
      "title": "Jobs",
      "type": "array"
    }
  },
  "required": [
    "version",
    "jobs"
  ],
  "title": "mkbrr Batch Manifest",
  "type": "object"
}
